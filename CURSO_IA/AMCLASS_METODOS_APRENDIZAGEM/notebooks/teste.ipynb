   "source": [
    "import matplotlib.pyplot as plt\n",
    "\n",
    "plt.rcParams[\"text.usetex\"] = True\n",
    "\n",
    "plt.figure(figsize=(6, 4))\n",
    "plt.plot([1, 2, 3], [1, 4, 9])\n",
    "plt.title(r\"Teste com LaTeX: $y=x^2$\")\n",
    "plt.xlabel(r\"$x$\")\n",
    "plt.ylabel(r\"$y$\")\n",
    "plt.grid()\n",
    "plt.show()"
   ]
  }
 ],
